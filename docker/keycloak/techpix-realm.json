{
  "realm": "techpix",
  "enabled": true,
  "displayName": "Tech Pix",
  "registrationAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "techpix-admin",
        "description": "Administra a Tech Pix: seed, fraud admin, replay de eventos"
      },
      {
        "name": "techpix-user",
        "description": "Usuario comum da Tech Pix (cliente do app)"
      },
      {
        "name": "techpix-suporte",
        "description": "Suporte N1/N2: consulta pagamentos, nao altera estado"
      },
      {
        "name": "techpix-compliance",
        "description": "Compliance: relatorios, reconciliacao, auditoria"
      },
      {
        "name": "fraud-evaluate",
        "description": "Permissao de SERVICO: chamar POST /fraud/evaluations no Fraud Service"
      },
      {
        "name": "payments-read",
        "description": "Permissao de SERVICO: consultar pagamentos no monolito"
      },
      {
        "name": "payments-write",
        "description": "Permissao de SERVICO: criar/alterar pagamentos no monolito"
      }
    ]
  },
  "clients": [
    {
      "clientId": "techpix-monolith",
      "name": "Tech Pix Monolith",
      "description": "Cliente confidencial do monolito (authorization code + password grant para demo + client credentials para falar com o Fraud Service)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "techpix-monolith-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-as-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-fraud-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "techpix-fraud-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "techpix-fraud-service",
      "name": "Tech Pix Fraud Service",
      "description": "Cliente confidencial do Fraud Service: valida (introspecta) tokens recebidos do monolito e consome eventos",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "techpix-fraud-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "realm-roles-as-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "maria",
      "enabled": true,
      "firstName": "Maria",
      "lastName": "Silva",
      "email": "maria@techpix.example",
